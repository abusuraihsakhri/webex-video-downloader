{
  "manifest_version": 3,
  "name": "WebXDownloader",
  "version": "1.4.0",
  "description": "Download authorized Webex recordings and export available stream and chat data.",
  "author": "Abu Suraih Sakhri",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.webex.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.webex.com/recordingservice/sites/*",
        "https://*.webex.com/webappng/sites/*"
      ],
      "js": [
        "utils.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "WebXDownloader",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
